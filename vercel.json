{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if git diff --name-only HEAD^ HEAD | grep -Ev '^(docs/|handoffs/|bootstrap/|\\.github/|README\\.md$)' | grep -q .; then exit 1; else exit 0; fi",
  "rewrites": [
    {
      "source": "/",
      "destination": "/src-greenn/preview/index.html"
    },
    {
      "source": "/obrigado/",
      "destination": "/src-greenn/preview/obrigado.html"
    },
    {
      "source": "/empreendimentos/capiitolo-piero-lissoni/",
      "destination": "/src-greenn/empreendimentos/capiitolo-piero-lissoni/index.html"
    },
    {
      "source": "/empreendimentos/caminhos-da-lapa-elo-duo/",
      "destination": "/src-greenn/empreendimentos/caminhos-da-lapa-elo-duo/index.html"
    },
    {
      "source": "/empreendimentos/aria-higienopolis/",
      "destination": "/src-greenn/empreendimentos/aria-higienopolis/index.html"
    },
    {
      "source": "/empreendimentos/dsg-itaim/",
      "destination": "/src-greenn/empreendimentos/dsg-itaim/index.html"
    },
    {
      "source": "/empreendimentos/ledge-brooklin/",
      "destination": "/src-greenn/empreendimentos/ledge-brooklin/index.html"
    },
    {
      "source": "/empreendimentos/soma-perdizes/",
      "destination": "/src-greenn/empreendimentos/soma-perdizes/index.html"
    },
    {
      "source": "/empreendimentos/zahle-jardins/",
      "destination": "/src-greenn/empreendimentos/zahle-jardins/index.html"
    },
    {
      "source": "/empreendimentos/ypy-alto-do-ipiranga/",
      "destination": "/src-greenn/empreendimentos/ypy-alto-do-ipiranga/index.html"
    },
    {
      "source": "/empreendimentos/bem-moema/",
      "destination": "/src-greenn/empreendimentos/bem-moema/index.html"
    },
    {
      "source": "/empreendimentos/mozae-higienopolis/",
      "destination": "/src-greenn/empreendimentos/mozae-higienopolis/index.html"
    },
    {
      "source": "/empreendimentos/bueno-brandao-257/",
      "destination": "/src-greenn/empreendimentos/bueno-brandao-257/index.html"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, must-revalidate"
        }
      ]
    },
    {
      "source": "/(favicon-16x16.png|favicon-32x32.png|favicon-48x48.png|favicon-96x96.png|favicon-192x192.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/empreendimentos/capitolo-piero-lissoni/",
      "destination": "/empreendimentos/capiitolo-piero-lissoni/",
      "permanent": true
    },
    {
      "source": "/empreendimentos/capitolo-tegra/",
      "destination": "/empreendimentos/capiitolo-piero-lissoni/",
      "permanent": true
    }
  ]
}
