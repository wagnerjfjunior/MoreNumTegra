{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if git diff --name-only HEAD^ HEAD | grep -Ev '^(docs/|handoffs/|bootstrap/|\\.github/|README\\.md$)' | grep -q .; then exit 1; else exit 0; fi",
  "redirects": [
    { "source": "/obrigado", "destination": "/obrigado/", "permanent": true },
    { "source": "/empreendimentos/capiitolo-piero-lissoni", "destination": "/empreendimentos/capiitolo-piero-lissoni/", "permanent": true },
    { "source": "/empreendimentos/caminhos-da-lapa-elo-duo", "destination": "/empreendimentos/caminhos-da-lapa-elo-duo/", "permanent": true },
    { "source": "/empreendimentos/aria-higienopolis", "destination": "/empreendimentos/aria-higienopolis/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/src-greenn/preview/index.html" },
    { "source": "/obrigado/", "destination": "/src-greenn/preview/obrigado.html" },
    { "source": "/empreendimentos/capiitolo-piero-lissoni/", "destination": "/src-greenn/empreendimentos/capiitolo-piero-lissoni/index.html" },
    { "source": "/empreendimentos/caminhos-da-lapa-elo-duo/", "destination": "/src-greenn/empreendimentos/caminhos-da-lapa-elo-duo/index.html" },
    { "source": "/empreendimentos/aria-higienopolis/", "destination": "/src-greenn/empreendimentos/aria-higienopolis/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": ".*\\.vercel\\.app" }
      ],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
