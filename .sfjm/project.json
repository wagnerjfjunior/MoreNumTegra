{
  "version": 1,
  "project": "MoreNumTegra",
  "repository": {
    "fullName": "wagnerjfjunior/MoreNumTegra",
    "defaultBranch": "main"
  },
  "local": {
    "preferredPort": 8080,
    "route": "/",
    "root": ".",
    "liveSync": {
      "engine": ".sfjm/live-sync.mjs",
      "mode": "remote-watch-ff-only",
      "pollMs": 4000,
      "autoBrowserRefresh": true,
      "requireExplicitBranch": true,
      "dirtyWorktreePolicy": "fail-closed",
      "allowResetHard": false,
      "allowGitClean": false
    }
  },
  "runtime": {
    "mode": "auto"
  },
  "validation": {
    "commands": []
  },
  "promotion": {
    "policy": "local-first-remote-on-promotion",
    "remoteIterationAllowed": false,
    "pushRequiresExplicitIntent": true,
    "deployRequiresExplicitIntent": true
  }
}
